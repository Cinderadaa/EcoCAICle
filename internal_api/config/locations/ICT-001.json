        "mapping_reason": "rdf_allowlist_match"
      },
      {
        "id": "fallback",
        "bin_id": "ICT-001-B01",
        "mapping_reason": "default_general_fallback",
        "mapping_reasons": {
          "unknown": "unknown_category_fallback",
          "low_confidence": "low_confidence_fallback",
          "contaminated": "contaminated_without_preparation_fallback",
          "unknown_condition": "unknown_cleanliness_fallback",
